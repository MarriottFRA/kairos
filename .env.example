# Kairos — local development environment.
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.

# ------------------------------------------------------------------------------
# Secure database — development stand-in for the server key half.
# ------------------------------------------------------------------------------
# The encrypted feature database (src/secure_db.ts) needs two 32-byte halves to
# derive its key encryption key: one held locally as a DPAPI blob, one released
# per device by the API. The API endpoint does not exist yet, so in development
# this fixed value stands in for the server's half.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Accepts 64 hex chars or 44 base64 chars.
#
# NOTE: changing this value after the database has been created makes the
# existing kairos_secure.db permanently unreadable — the app will refuse to open
# it rather than silently discarding your data. Set it once and leave it.
#
# This is ignored in packaged builds (gated on app.isPackaged), so it cannot leak
# into a release as a shared key.
KAIROS_DEV_SERVER_KEY_HALF=

# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------
# "debug" to force verbose logging.
LOG_LEVEL=
